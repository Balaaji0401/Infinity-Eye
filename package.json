{
  "name": "infinity-eye",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "preflight": "node scripts/preflight.mjs",
    "build": "node scripts/preflight.mjs && node scripts/build-web.mjs",
    "build:web": "node scripts/build-web.mjs --force",
    "deploy": "wrangler deploy",
    "dev": "npm run build && wrangler dev --config config/wrangler.local.toml",
    "migrate:local": "wrangler d1 migrations apply DB --local --config config/wrangler.local.toml",
    "test": "node --test test/*.test.js",
    "check": "npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "wrangler": "^4.40.0"
  }
}
